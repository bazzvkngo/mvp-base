rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function platformUserIsActive(uid) {
      return !firestore.exists(
          /databases/(default)/documents/usuarios/$(uid)
        ) || firestore.get(
          /databases/(default)/documents/usuarios/$(uid)
        ).data.get("estadoPlataforma", "activo") != "suspendido";
    }

    function businessMembership(businessId) {
      return firestore.get(
        /databases/(default)/documents/membresias/$(businessId + "__" + request.auth.uid)
      );
    }

    function hasBusinessMembership(businessId) {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/membresias/$(businessId + "__" + request.auth.uid)
        );
    }

    function activeBusiness(businessId) {
      return firestore.get(
        /databases/(default)/documents/negocios/$(businessId)
      );
    }

    function hasActiveBusinessDocument(businessId) {
      return firestore.exists(
        /databases/(default)/documents/negocios/$(businessId)
      );
    }

    function canAccessBusiness(businessId) {
      return hasBusinessMembership(businessId)
        && platformUserIsActive(request.auth.uid)
        && hasActiveBusinessDocument(businessId)
        && businessMembership(businessId).data.uid == request.auth.uid
        && businessMembership(businessId).data.negocioId == businessId
        && businessMembership(businessId).data.estado == "activo"
        && activeBusiness(businessId).data.estado == "activo";
    }

    function canManageBusiness(businessId) {
      return canAccessBusiness(businessId)
        && businessMembership(businessId).data.rol in ["OWNER", "ADMIN"];
    }

    function canAccessBusinessVerificationEvidence(businessId, ownerUid) {
      return request.auth != null
        && request.auth.uid == ownerUid
        && platformUserIsActive(ownerUid)
        && hasActiveBusinessDocument(businessId)
        && activeBusiness(businessId).data.estado == "activo"
        && activeBusiness(businessId).data.creadoPorUid == request.auth.uid;
    }

    // SPEC 020 (evidencia de gastos): la evidencia es un adjunto de un gasto
    // ya existente, nunca un modelo contable nuevo. Estas funciones replican,
    // para Storage, exactamente el mismo criterio de autorización que ya usan
    // Functions/Firestore Rules para gastos (WORK_OPERATION_ROLES para operar,
    // autoatribución para TECNICO/MEMBER, canReadWorkCosts para lectura) —
    // ningún rol ni permiso nuevo.
    function workExpensePath(businessId, workId, expenseId) {
      return /databases/(default)/documents/negocios/$(businessId)/trabajos/$(workId)/gastos/$(expenseId);
    }

    function workExpenseBelongsToWork(businessId, workId, expenseId) {
      return firestore.exists(workExpensePath(businessId, workId, expenseId))
        && firestore.get(workExpensePath(businessId, workId, expenseId)).data.negocioId == businessId
        && firestore.get(workExpensePath(businessId, workId, expenseId)).data.trabajoId == workId;
    }

    function isWorkExpenseSelfAttributed(businessId, workId, expenseId) {
      let expense = firestore.get(workExpensePath(businessId, workId, expenseId)).data;
      return expense.get("registradoPorUid", "") == request.auth.uid
        || expense.get("responsableDelGastoUid", "") == request.auth.uid;
    }

    // Lectura: mismo criterio que canReadWorkCosts (Firestore) — OWNER/ADMIN/
    // FINANZAS/MEMBER sin restricción adicional, TECNICO sólo sobre un gasto
    // propio (registrado por él o del que es responsable).
    function canReadWorkExpenseEvidence(businessId, workId, expenseId) {
      return canAccessBusiness(businessId)
        && workExpenseBelongsToWork(businessId, workId, expenseId)
        && (
          businessMembership(businessId).data.rol in ["OWNER", "ADMIN", "FINANZAS", "MEMBER"]
          || (
            businessMembership(businessId).data.rol == "TECNICO"
            && isWorkExpenseSelfAttributed(businessId, workId, expenseId)
          )
        );
    }

    // Creación: mismo criterio que registrarGastoTrabajo — OWNER/ADMIN sin
    // restricción, TECNICO/MEMBER sólo sobre un gasto propio; el gasto debe
    // seguir vigente (un gasto anulado no admite evidencia nueva).
    function canCreateWorkExpenseEvidence(businessId, workId, expenseId) {
      return canAccessBusiness(businessId)
        && workExpenseBelongsToWork(businessId, workId, expenseId)
        && firestore.get(workExpensePath(businessId, workId, expenseId)).data.estado == "vigente"
        && (
          businessMembership(businessId).data.rol in ["OWNER", "ADMIN"]
          || (
            businessMembership(businessId).data.rol in ["TECNICO", "MEMBER"]
            && isWorkExpenseSelfAttributed(businessId, workId, expenseId)
          )
        );
    }

    function canRollbackBusinessVerificationEvidence(
      businessId,
      ownerUid,
      requestId
    ) {
      // La propiedad/actividad se validaron al crear el objeto. En rollback,
      // usuario + solicitud consumen el máximo de dos documentos permitido.
      return request.auth != null
        && request.auth.uid == ownerUid
        && platformUserIsActive(ownerUid)
        && !firestore.exists(
          /databases/(default)/documents/negocios/$(businessId)/businessVerificationRequests/$(requestId)
        );
    }

    match /usuarios/{uid}/empresa/logo/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && platformUserIsActive(uid);

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && platformUserIsActive(uid)
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp)'
        );

      allow delete: if request.auth != null
        && request.auth.uid == uid
        && platformUserIsActive(uid);
    }

    match /negocios/{businessId}/empresa/logo/{fileName} {
      allow read: if canAccessBusiness(businessId);

      allow create, update: if canManageBusiness(businessId)
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp)'
        );

      allow delete: if canManageBusiness(businessId);
    }

    match /negocios/{businessId}/verificacion/{ownerUid}/{requestId}/{fileName} {
      allow read: if canAccessBusinessVerificationEvidence(
        businessId,
        ownerUid
      );

      allow create: if resource == null
        && request.resource != null
        && canAccessBusinessVerificationEvidence(businessId, ownerUid)
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|image/(jpeg|png)'
        );

      // Permite revertir sólo una evidencia cuyo request todavía no fue
      // persistido por la Function. Una evidencia asociada queda inmutable.
      allow delete: if resource != null
        && canRollbackBusinessVerificationEvidence(
          businessId,
          ownerUid,
          requestId
        );
    }

    match /negocios/{businessId}/trabajos/{workId}/gastos/{expenseId}/{fileName} {
      allow read: if canReadWorkExpenseEvidence(businessId, workId, expenseId);

      allow create: if resource == null
        && request.resource != null
        && canCreateWorkExpenseEvidence(businessId, workId, expenseId)
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|image/(jpeg|png)'
        );

      // Sin reemplazo (create-only, ya garantizado por "resource == null"
      // arriba) y sin borrado físico: la evidencia asociada a un gasto es
      // inmutable una vez subida, igual que el invariante de AGENTS.md de no
      // eliminar registros referenciados. A diferencia de la evidencia de
      // verificación empresarial, aquí no existe ventana de rollback: el
      // gasto ya existe antes de subir el archivo (el registro en Firestore
      // es previo a la evidencia, no posterior).
      allow update: if false;
      allow delete: if false;
    }
  }
}
