rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasValidDocumentOwner(uid) {
      return !request.resource.data.keys().hasAny(["uidUsuario"])
        || request.resource.data.uidUsuario == uid;
    }

    function isAllowedReferenceTaskUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
        request.resource.data.estado == "resuelta"
        && changed.hasOnly(["estado", "actualizadoEn", "resueltaEn"])
      ) || (
        request.resource.data.estado == "aplazada"
        && changed.hasOnly(["estado", "actualizadoEn", "aplazadaHasta"])
      );
    }

    function hasValidQuoteStatus() {
      return request.resource.data.estado in [
        "borrador",
        "emitida",
        "aceptada",
        "rechazada",
        "vencida",
        "archivada"
      ];
    }

    function quoteEmailFieldsAreServerOnly() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "emailClienteDestino",
        "fechaEnvioCorreo",
        "asuntoCorreo",
        "mensajeCorreo",
        "archivoAdjuntoCorreo",
        "enviadoPorCorreo",
        "estadoEnvioCorreo",
        "proveedorCorreo",
        "ultimoErrorEnvio",
        "idEnvioCorreoProveedor"
      ]);
    }

    function isAllowedQuoteUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return hasValidDocumentOwner(uid)
        && hasValidQuoteStatus()
        && quoteEmailFieldsAreServerOnly()
        && (
          resource.data.estado == "borrador"
          || changed.hasOnly(["estado", "estadoAnterior", "actualizadoEn"])
        );
    }

    match /usuarios/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;

      match /config/{docId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      match /empresa/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && hasValidDocumentOwner(uid);
        allow delete: if false;
      }

      match /inventario/{itemId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && hasValidDocumentOwner(uid);
        allow delete: if false;
      }

      match /referencias/{referenceId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && hasValidDocumentOwner(uid);
        allow delete: if false;
      }

      match /cotizaciones/{quoteId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && hasValidDocumentOwner(uid)
          && hasValidQuoteStatus()
          && !request.resource.data.keys().hasAny([
            "emailClienteDestino",
            "fechaEnvioCorreo",
            "asuntoCorreo",
            "mensajeCorreo",
            "archivoAdjuntoCorreo",
            "enviadoPorCorreo",
            "estadoEnvioCorreo",
            "proveedorCorreo",
            "ultimoErrorEnvio",
            "idEnvioCorreoProveedor"
          ]);
        allow update: if isOwner(uid) && isAllowedQuoteUpdate(uid);
        allow delete: if false;
      }

      match /contadores/{counterId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      match /tareasReferencias/{taskId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid) && isAllowedReferenceTaskUpdate();
        allow create, delete: if false;
      }
    }
  }
}
