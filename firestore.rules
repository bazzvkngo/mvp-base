rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformUserActive(uid) {
      let userPath = /databases/$(database)/documents/usuarios/$(uid);
      return !exists(userPath)
        || get(userPath).data.get("estadoPlataforma", "activo") != "suspendido";
    }

    function isOwner(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && isPlatformUserActive(uid);
    }

    function membershipPath(businessId, uid) {
      return /databases/$(database)/documents/membresias/$(businessId + "__" + uid);
    }

    function isActiveBusinessMember(businessId) {
      return isSignedIn()
        && isPlatformUserActive(request.auth.uid)
        && exists(membershipPath(businessId, request.auth.uid))
        && get(membershipPath(businessId, request.auth.uid)).data.uid
          == request.auth.uid
        && get(membershipPath(businessId, request.auth.uid)).data.negocioId
          == businessId
        && get(membershipPath(businessId, request.auth.uid)).data.estado
          == "activo";
    }

    function isActiveBusiness(businessId) {
      let businessPath = /databases/$(database)/documents/negocios/$(businessId);
      return exists(businessPath)
        && get(businessPath).data.estado == "activo"
        && get(businessPath).data.get("eliminadoEn", null) == null;
    }

    function canAccessBusiness(businessId) {
      return isActiveBusinessMember(businessId) && isActiveBusiness(businessId);
    }

    function isVerifiedBusiness(businessId) {
      let businessPath = /databases/$(database)/documents/negocios/$(businessId);
      return exists(businessPath)
        && get(businessPath).data.get("verificacionEmpresa", {}).get("estado", "NO_VERIFICADA")
          == "VERIFICADA";
    }

    function canOperateBusiness(businessId) {
      return canAccessBusiness(businessId) && isVerifiedBusiness(businessId);
    }

    function canOperateActiveBusiness(uid) {
      let userPath = /databases/$(database)/documents/usuarios/$(uid);
      return isOwner(uid)
        && exists(userPath)
        && canOperateBusiness(get(userPath).data.get("negocioActivoId", ""));
    }

    function hasSetupBusinessRole(businessId, roles) {
      return canAccessBusiness(businessId)
        && get(membershipPath(businessId, request.auth.uid)).data.rol in roles;
    }

    function hasBusinessRole(businessId, roles) {
      return canOperateBusiness(businessId)
        && get(membershipPath(businessId, request.auth.uid)).data.rol in roles;
    }

    function employeeProfilePath(businessId) {
      return /databases/$(database)/documents/negocios/$(businessId)/perfilesEmpleados/$(get(membershipPath(businessId, request.auth.uid)).data.get("profileId", ""));
    }

    function hasCustomBusinessModule(businessId, modules) {
      return canOperateBusiness(businessId)
        && get(membershipPath(businessId, request.auth.uid)).data.rol == "MEMBER"
        && get(membershipPath(businessId, request.auth.uid)).data.get("profileId", "") != ""
        && exists(employeeProfilePath(businessId))
        && get(employeeProfilePath(businessId)).data.negocioId == businessId
        && get(employeeProfilePath(businessId)).data.estado == "activo"
        && get(employeeProfilePath(businessId)).data.modulos.hasAny(modules);
    }

    function hasCustomSetupBusinessModule(businessId, modules) {
      return canAccessBusiness(businessId)
        && get(membershipPath(businessId, request.auth.uid)).data.rol == "MEMBER"
        && get(membershipPath(businessId, request.auth.uid)).data.get("profileId", "") != ""
        && exists(employeeProfilePath(businessId))
        && get(employeeProfilePath(businessId)).data.negocioId == businessId
        && get(employeeProfilePath(businessId)).data.estado == "activo"
        && get(employeeProfilePath(businessId)).data.modulos.hasAny(modules);
    }

    function hasBusinessModuleAccess(businessId, roles, modules) {
      return (
        hasBusinessRole(businessId, roles)
        && (
          get(membershipPath(businessId, request.auth.uid)).data.rol != "MEMBER"
          || get(membershipPath(businessId, request.auth.uid)).data.get("profileId", "") == ""
        )
      ) || hasCustomBusinessModule(businessId, modules);
    }

    function hasSetupBusinessModuleAccess(businessId, roles, modules) {
      return (
        hasSetupBusinessRole(businessId, roles)
        && (
          get(membershipPath(businessId, request.auth.uid)).data.rol != "MEMBER"
          || get(membershipPath(businessId, request.auth.uid)).data.get("profileId", "") == ""
        )
      ) || hasCustomSetupBusinessModule(businessId, modules);
    }

    function isAssignedWorkData(work) {
      return work.get("responsableUid", "") == request.auth.uid
        || request.auth.uid in work.get("participanteUids", []);
    }

    function canReadWork(businessId, workId) {
      let workPath = /databases/$(database)/documents/negocios/$(businessId)/trabajos/$(workId);
      return hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "FINANZAS", "MEMBER"], ["trabajos", "reportes"])
        || (
          hasBusinessRole(businessId, ["TECNICO"])
          && exists(workPath)
          && isAssignedWorkData(get(workPath).data)
        );
    }

    function canReadWorkOperations(businessId, workId) {
      return hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "MEMBER"], ["trabajos", "reportes"])
        || (canReadWork(businessId, workId) && hasBusinessRole(businessId, ["TECNICO"]));
    }

    function canReadWorkCosts(businessId, workId, record) {
      return hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "FINANZAS", "MEMBER"], ["trabajos", "reportes"])
        || (
          canReadWork(businessId, workId)
          && hasBusinessRole(businessId, ["TECNICO"])
          && (
            record.get("registradoPorUid", "") == request.auth.uid
            || record.get("responsableDelGastoUid", "") == request.auth.uid
            || record.get("tecnicoUid", "") == request.auth.uid
          )
        );
    }

    function hasValidDocumentOwner(uid) {
      return !request.resource.data.keys().hasAny(["uidUsuario"])
        || request.resource.data.uidUsuario == uid;
    }

    function hasValidBusinessDocument(businessId) {
      return request.resource.data.negocioId == businessId;
    }

    function isAllowedBusinessLogoProfileCreate(businessId) {
      return hasValidBusinessDocument(businessId)
        && request.resource.data.keys().hasOnly([
          "negocioId",
          "logoUrl",
          "logoPath",
          "logoNombreOriginal",
          "logoActualizadoEn",
          "actualizadoEn"
        ]);
    }

    function isAllowedBusinessLogoProfileUpdate(businessId) {
      return hasValidBusinessDocument(businessId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "negocioId",
          "logoUrl",
          "logoPath",
          "logoNombreOriginal",
          "logoActualizadoEn",
          "actualizadoEn"
        ]);
    }

    function inventoryCodesAreImmutable() {
      return request.resource.data.get("codigoInterno", null)
          == resource.data.get("codigoInterno", null)
        && request.resource.data.get("sku", null)
          == resource.data.get("sku", null);
    }

    function isInventoryLifecycleUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(["estado", "actualizadoEn", "eliminadoEn"]);
    }

    function hasValidInventoryCatalogRelation(uid) {
      let areaId = request.resource.data.get("areaId", "");
      let categoriaId = request.resource.data.get("categoriaId", "");
      let areaPath = /databases/$(database)/documents/usuarios/$(uid)/areas/$(areaId);
      let categoryPath = /databases/$(database)/documents/usuarios/$(uid)/categoriasInventario/$(categoriaId);
      return areaId is string
        && areaId.size() > 0
        && categoriaId is string
        && categoriaId.size() > 0
        && exists(areaPath)
        && exists(categoryPath)
        && get(areaPath).data.estado == "activo"
        && get(categoryPath).data.estado == "activo"
        && get(categoryPath).data.areaId == areaId;
    }

    function hasValidBusinessInventoryCatalogRelation(businessId) {
      let areaId = request.resource.data.get("areaId", "");
      let categoriaId = request.resource.data.get("categoriaId", "");
      let areaPath = /databases/$(database)/documents/negocios/$(businessId)/areas/$(areaId);
      let categoryPath = /databases/$(database)/documents/negocios/$(businessId)/categoriasInventario/$(categoriaId);
      return areaId is string
        && categoriaId is string
        && (
          (areaId.size() == 0 && categoriaId.size() == 0)
          || (
            areaId.size() > 0
            && exists(areaPath)
            && get(areaPath).data.estado == "activo"
            && (
              categoriaId.size() == 0
              || (
                exists(categoryPath)
                && get(categoryPath).data.estado == "activo"
                && get(categoryPath).data.areaId == areaId
              )
            )
          )
        );
    }

    function hasValidProductFields() {
      return request.resource.data.get("marca", null) is string
        && request.resource.data.get("marca", "").size() > 0
        && request.resource.data.get("modelo", null) is string
        && request.resource.data.get("modelo", "").size() > 0
        && request.resource.data.get("stock", null) is number
        && request.resource.data.get("stock", -1) >= 0
        && request.resource.data.get("stockMinimo", null) is number
        && request.resource.data.get("stockMinimo", -1) >= 0
        && (
          !request.resource.data.keys().hasAny(["codigoBarras"])
          || request.resource.data.codigoBarras is string
        )
        && (
          !request.resource.data.keys().hasAny(["barcode"])
          || request.resource.data.barcode is string
        );
    }

    function businessAllowsNegativeStock(businessId) {
      let settingsPath = /databases/$(database)/documents/negocios/$(businessId)/configuracion/inventario;
      return exists(settingsPath)
        && get(settingsPath).data.permitirStockNegativo == true;
    }

    function hasValidBusinessProductFields(businessId) {
      return request.resource.data.stock is number
        && (request.resource.data.stock >= 0 || businessAllowsNegativeStock(businessId))
        && request.resource.data.stockMinimo is number
        && request.resource.data.stockMinimo >= 0
        && (
          !request.resource.data.keys().hasAny(["marca"])
          || request.resource.data.marca is string
        )
        && (
          !request.resource.data.keys().hasAny(["modelo"])
          || request.resource.data.modelo is string
        )
        && (
          !request.resource.data.keys().hasAny(["unidadStock"])
          || request.resource.data.unidadStock is string
        )
        && (
          !request.resource.data.keys().hasAny(["codigoBarras"])
          || request.resource.data.codigoBarras is string
        )
        && (
          !request.resource.data.keys().hasAny(["barcode"])
          || request.resource.data.barcode is string
        );
    }

    function hasNoProductFields() {
      return !request.resource.data.keys().hasAny([
        "marca",
        "modelo",
        "stock",
        "stockMinimo",
        "codigoBarras",
        "barcode",
        "unidadStock",
        "formacionPrecioVersion",
        "tasaImpuestoCompra",
        "montoImpuestoCompra",
        "costoPagado",
        "precioVentaSugerido"
      ]);
    }

    function hasNoInventoryAcquisitionFields() {
      return !request.resource.data.keys().hasAny([
        "modeloCostoInventarioVersion",
        "valorInventario",
        "valorInventarioMoneda",
        "baselineCostoInventario",
        "costoPromedio",
        "costoPromedioMoneda",
        "ultimoCosto",
        "ultimoProveedor",
        "ultimaAdquisicionId",
        "ultimaAdquisicionEn"
      ]);
    }

    function inventoryAuthoritativeFieldsAreImmutable() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "estado",
        "stock",
        "modeloCostoInventarioVersion",
        "valorInventario",
        "valorInventarioMoneda",
        "baselineCostoInventario",
        "costoPromedio",
        "costoPromedioMoneda",
        "ultimoCosto",
        "ultimoProveedor",
        "ultimaAdquisicionId",
        "ultimaAdquisicionEn"
      ]);
    }

    function hasValidPurchasePriceFormation() {
      let fields = [
        "formacionPrecioVersion",
        "tasaImpuestoCompra",
        "montoImpuestoCompra",
        "costoPagado",
        "precioVentaSugerido"
      ];
      return !request.resource.data.keys().hasAny(fields)
        || (
          request.resource.data.get("tipoItem", "") == "producto"
          && request.resource.data.keys().hasAll(fields)
          && request.resource.data.get("formacionPrecioVersion", null) == 2
          && request.resource.data.get("tasaImpuestoCompra", null) is number
          && request.resource.data.get("tasaImpuestoCompra", -1) >= 0
          && request.resource.data.get("tasaImpuestoCompra", 101) <= 100
          && request.resource.data.get("montoImpuestoCompra", null) is number
          && request.resource.data.get("montoImpuestoCompra", -1) >= 0
          && request.resource.data.get("costoPagado", null) is number
          && request.resource.data.get("costoPagado", -1) >= 0
          && request.resource.data.get("precioVentaSugerido", null) is number
          && request.resource.data.get("precioVentaSugerido", -1) >= 0
        );
    }

    function hasValidInventoryStructure(uid) {
      return request.resource.data.get("tipoItem", "") in ["producto", "servicio", "actividad"]
        && request.resource.data.get("nombre", null) is string
        && request.resource.data.get("nombre", "").size() > 0
        && request.resource.data.get("categoria", null) is string
        && request.resource.data.get("categoria", "").size() > 0
        && request.resource.data.get("unidad", null) is string
        && request.resource.data.get("unidad", "").size() > 0
        && request.resource.data.get("costoBase", null) is number
        && request.resource.data.get("margenDeseado", null) is number
        && request.resource.data.get("precioInterno", null) is number
        && hasValidInventoryCatalogRelation(uid)
        && hasValidPurchasePriceFormation()
        && (
          (
            request.resource.data.get("tipoItem", "") == "producto"
            && hasValidProductFields()
          )
          || (
            request.resource.data.get("tipoItem", "") != "producto"
            && hasNoProductFields()
          )
        );
    }

    function hasValidInventoryV2(uid) {
      return request.resource.data.get("modeloInventarioVersion", null) == 2
        && request.resource.data.get("codigoInterno", null) is string
        && request.resource.data.get("codigoInterno", "").size() > 0
        && hasValidInventoryStructure(uid);
    }

    function hasValidBusinessInventoryStructure(businessId) {
      return request.resource.data.get("tipoItem", "") in ["producto", "servicio", "actividad"]
        && request.resource.data.get("nombre", null) is string
        && request.resource.data.get("nombre", "").size() > 0
        && request.resource.data.get("categoria", null) is string
        && request.resource.data.get("categoria", "").size() >= 0
        && request.resource.data.get("unidad", null) is string
        && request.resource.data.get("unidad", "").size() > 0
        && request.resource.data.get("costoBase", null) is number
        && request.resource.data.get("margenDeseado", null) is number
        && request.resource.data.get("precioInterno", null) is number
        && hasValidBusinessInventoryCatalogRelation(businessId)
        && hasValidPurchasePriceFormation()
        && (
          (
            request.resource.data.get("tipoItem", "") == "producto"
            && hasValidBusinessProductFields(businessId)
          )
          || (
            request.resource.data.get("tipoItem", "") != "producto"
            && hasNoProductFields()
          )
        );
    }

    function hasValidBusinessInventoryV2(businessId) {
      return request.resource.data.get("modeloInventarioVersion", null) == 2
        && request.resource.data.get("codigoInterno", null) is string
        && request.resource.data.get("codigoInterno", "").size() > 0
        && request.resource.data.get("tipoItem", "") in ["producto", "servicio", "actividad"]
        && request.resource.data.get("nombre", null) is string
        && request.resource.data.get("nombre", "").size() > 0
        && request.resource.data.get("categoria", null) is string
        && request.resource.data.get("categoria", "").size() >= 0
        && request.resource.data.get("unidad", null) is string
        && request.resource.data.get("unidad", "").size() > 0
        && request.resource.data.get("costoBase", null) is number
        && request.resource.data.get("margenDeseado", null) is number
        && request.resource.data.get("precioInterno", null) is number
        && hasValidBusinessInventoryCatalogRelation(businessId)
        && hasValidPurchasePriceFormation()
        && (
          (
            request.resource.data.get("tipoItem", "") == "producto"
            && hasValidBusinessProductFields(businessId)
          )
          || (
            request.resource.data.get("tipoItem", "") != "producto"
            && hasNoProductFields()
          )
        );
    }

    function isAllowedLegacyInventoryUpdate(uid) {
      return resource.data.get("modeloInventarioVersion", null) == null
        && request.resource.data.get("modeloInventarioVersion", null) == null
        && request.resource.data.get("codigoInterno", null) == null
        && hasValidInventoryStructure(uid);
    }

    function isAllowedLegacyBusinessInventoryUpdate(businessId) {
      return resource.data.get("modeloInventarioVersion", null) == null
        && request.resource.data.get("modeloInventarioVersion", null) == null
        && request.resource.data.get("codigoInterno", null) == null
        && request.resource.data.negocioId == businessId
        && request.resource.data.get("tipoItem", "") in ["producto", "servicio", "actividad"]
        && request.resource.data.get("nombre", null) is string
        && request.resource.data.get("nombre", "").size() > 0
        && request.resource.data.get("categoria", null) is string
        && request.resource.data.get("categoria", "").size() >= 0
        && request.resource.data.get("unidad", null) is string
        && request.resource.data.get("unidad", "").size() > 0
        && request.resource.data.get("costoBase", null) is number
        && request.resource.data.get("margenDeseado", null) is number
        && request.resource.data.get("precioInterno", null) is number
        && hasValidBusinessInventoryCatalogRelation(businessId)
        && hasValidPurchasePriceFormation()
        && (
          (
            request.resource.data.get("tipoItem", "") == "producto"
            && hasValidBusinessProductFields(businessId)
          )
          || (
            request.resource.data.get("tipoItem", "") != "producto"
            && hasNoProductFields()
          )
        );
    }

    function isAllowedLegacyInventoryCreate() {
      return !request.resource.data.keys().hasAny([
        "codigoInterno",
        "modeloInventarioVersion",
        "areaId",
        "categoriaId"
      ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.tipoItem in ["producto", "servicio", "actividad"]
        && request.resource.data.unidad is string
        && request.resource.data.unidad.size() > 0
        && request.resource.data.costoBase is number
        && request.resource.data.margenDeseado is number
        && request.resource.data.precioInterno is number
        && (
          request.resource.data.get("creadoDesdeCotizacion", false) == true
          || request.resource.data.get("origen", "") in [
            "importacion_documental_multiformato",
            "importacion_inteligente_archivo"
          ]
        );
    }

    function isAllowedReferenceTaskUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
        request.resource.data.estado == "resuelta"
        && changed.hasOnly(["estado", "actualizadoEn", "resueltaEn"])
      ) || (
        request.resource.data.estado == "aplazada"
        && changed.hasOnly(["estado", "actualizadoEn", "aplazadaHasta"])
      );
    }

    function hasValidFinancialCategory(type, categoryId) {
      return (
        type == "income"
        && categoryId in ["sales", "services", "deposits", "other_income"]
      ) || (
        type == "expense"
        && categoryId in [
          "purchases",
          "suppliers",
          "transport",
          "utilities",
          "payroll",
          "rent",
          "taxes",
          "other_expense"
        ]
      );
    }

    function hasValidFinancialMovementStructure(businessId) {
      return request.resource.data.keys().hasAll([
          "modelVersion",
          "businessId",
          "type",
          "status",
          "amount",
          "date",
          "concept",
          "categoryId",
          "paymentMethodId",
          "counterpartyName",
          "note",
          "reference",
          "sourceType",
          "sourceId",
          "searchText",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "modelVersion",
          "businessId",
          "type",
          "status",
          "amount",
          "date",
          "concept",
          "categoryId",
          "paymentMethodId",
          "counterpartyName",
          "note",
          "reference",
          "sourceType",
          "sourceId",
          "searchText",
          "createdBy",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.modelVersion == 1
        && request.resource.data.businessId == businessId
        && request.resource.data.type in ["income", "expense"]
        && request.resource.data.status in ["paid", "pending"]
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.concept is string
        && request.resource.data.concept.size() > 0
        && request.resource.data.concept.size() <= 160
        && request.resource.data.categoryId is string
        && hasValidFinancialCategory(
          request.resource.data.type,
          request.resource.data.categoryId
        )
        && request.resource.data.paymentMethodId in [
          "cash",
          "debit_card",
          "credit_card",
          "bank_transfer",
          "other"
        ]
        && request.resource.data.counterpartyName is string
        && request.resource.data.counterpartyName.size() <= 160
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 120
        && request.resource.data.sourceType in [
          "manual",
          "sale",
          "quote",
          "inventory"
        ]
        && request.resource.data.sourceId is string
        && request.resource.data.sourceId.size() <= 160
        && (
          request.resource.data.sourceType == "manual"
          || request.resource.data.sourceId.size() > 0
        )
        && request.resource.data.searchText is string
        && request.resource.data.searchText.size() <= 1000
        && request.resource.data.createdBy is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isAllowedFinancialMovementCreate(businessId) {
      return hasValidFinancialMovementStructure(businessId)
        && request.resource.data.sourceType == "manual"
        && request.resource.data.sourceId == ""
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isAllowedFinancialMovementUpdate(businessId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.businessId == businessId
        && resource.data.sourceType == "manual"
        && hasValidFinancialMovementStructure(businessId)
        && request.resource.data.modelVersion == resource.data.modelVersion
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.sourceType == resource.data.sourceType
        && request.resource.data.sourceId == resource.data.sourceId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && changed.hasOnly([
          "type",
          "status",
          "amount",
          "date",
          "concept",
          "categoryId",
          "paymentMethodId",
          "counterpartyName",
          "note",
          "reference",
          "searchText",
          "updatedAt"
        ]);
    }

    match /usuarios/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;

      match /sistema/{docId} {
        allow read, create, update, delete: if false;
      }

      match /businessCreateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /businessDeleteRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /eventosPlataforma/{eventId} {
        allow read, create, update, delete: if false;
      }

      match /config/{docId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      match /cuenta/{docId} {
        allow read: if isOwner(uid) && docId == "perfil";
        allow create, update, delete: if false;
      }

      match /empresa/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && hasValidDocumentOwner(uid);
        allow delete: if false;
      }

      match /inventario/{itemId} {
        allow read: if canOperateActiveBusiness(uid);
        allow create: if canOperateActiveBusiness(uid)
          && hasValidDocumentOwner(uid)
          && hasNoInventoryAcquisitionFields()
          && isAllowedLegacyInventoryCreate();
        allow update: if canOperateActiveBusiness(uid)
          && hasValidDocumentOwner(uid)
          && inventoryCodesAreImmutable()
          && inventoryAuthoritativeFieldsAreImmutable()
          // hasValidInventoryStructure(uid) se evalúa una sola vez y se
          // combina con el discriminador V2/legacy (antes: dos llamadas
          // separadas, una por rama del OR, duplicando exists()/get() de
          // hasValidInventoryCatalogRelation) — misma política exacta por
          // ley distributiva: (A∧C)∨(B∧C) ≡ C∧(A∨B).
          && hasValidInventoryStructure(uid)
          && (
            (
              request.resource.data.get("modeloInventarioVersion", null) == 2
              && request.resource.data.get("codigoInterno", null) is string
              && request.resource.data.get("codigoInterno", "").size() > 0
            )
            || (
              resource.data.get("modeloInventarioVersion", null) == null
              && request.resource.data.get("modeloInventarioVersion", null) == null
              && request.resource.data.get("codigoInterno", null) == null
            )
          );
        allow delete: if false;
      }

      match /areas/{areaId} {
        allow read: if canOperateActiveBusiness(uid);
        allow create, update, delete: if false;
      }

      match /categoriasInventario/{categoryId} {
        allow read: if canOperateActiveBusiness(uid);
        allow create, update, delete: if false;
      }

      match /inventarioContadores/{counterId} {
        allow read, create, update, delete: if false;
      }

      match /inventoryCatalogKeys/{keyId} {
        allow read, create, update, delete: if false;
      }

      match /inventoryCreateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /inventoryImportRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /inventoryUpdateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /inventoryCodeKeys/{codeKeyId} {
        allow read, create, update, delete: if false;
      }

      match /inventoryBarcodeKeys/{barcodeKeyId} {
        allow read, create, update, delete: if false;
      }

      match /inventoryStatusRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /referencias/{referenceId} {
        allow read: if canOperateActiveBusiness(uid);
        allow create, update: if canOperateActiveBusiness(uid) && hasValidDocumentOwner(uid);
        allow delete: if false;
      }

      match /cotizaciones/{quoteId} {
        allow read: if canOperateActiveBusiness(uid);
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      match /contadores/{counterId} {
        allow read, create, update, delete: if false;
      }

      match /quoteCreateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /tareasReferencias/{taskId} {
        allow read: if canOperateActiveBusiness(uid);
        allow update: if canOperateActiveBusiness(uid) && isAllowedReferenceTaskUpdate();
        allow create, delete: if false;
      }
    }

    match /negocios/{businessId} {
      allow read: if isActiveBusinessMember(businessId)
        && resource.data.estado == "activo"
        && resource.data.get("eliminadoEn", null) == null;
      allow create, update, delete: if false;

      match /config/{docId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "VENTAS", "COMPRAS", "TECNICO", "FINANZAS", "MEMBER"], ["reportes", "trabajos", "inventario", "clientes", "cotizaciones", "ventas", "proveedores", "ordenes_compra", "recepciones", "compras", "empresa", "empleados"]);
        allow create, update: if hasBusinessRole(businessId, ["OWNER", "ADMIN"])
          && hasValidBusinessDocument(businessId);
        allow delete: if false;
      }

      match /configuracion/{sectionId} {
        allow read: if canAccessBusiness(businessId);
        allow create, update, delete: if false;
      }

      match /empresa/{docId} {
        allow read: if hasSetupBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "VENTAS", "COMPRAS", "TECNICO", "FINANZAS", "MEMBER"], ["empresa", "reportes"]);
        allow create: if docId == "perfil"
          && hasSetupBusinessRole(businessId, ["OWNER", "ADMIN"])
          && isAllowedBusinessLogoProfileCreate(businessId);
        allow update: if docId == "perfil"
          && hasSetupBusinessRole(businessId, ["OWNER", "ADMIN"])
          && isAllowedBusinessLogoProfileUpdate(businessId);
        allow delete: if false;
      }

      match /inventario/{itemId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "VENTAS", "COMPRAS", "TECNICO", "FINANZAS", "MEMBER"], ["inventario", "cotizaciones", "ordenes_compra", "recepciones", "compras", "trabajos", "reportes"]);
        allow create: if hasBusinessRole(businessId, ["OWNER", "ADMIN", "COMPRAS"])
          && hasValidBusinessDocument(businessId)
          && hasNoInventoryAcquisitionFields()
          && isAllowedLegacyInventoryCreate();
        allow update: if hasBusinessRole(businessId, ["OWNER", "ADMIN", "COMPRAS"])
          && hasValidBusinessDocument(businessId)
          && inventoryCodesAreImmutable()
          && inventoryAuthoritativeFieldsAreImmutable()
          // hasValidBusinessInventoryStructure(businessId) se evalúa una
          // sola vez y se combina con el discriminador V2/legacy (antes:
          // dos llamadas separadas, una por rama del OR, duplicando
          // exists()/get() de hasValidBusinessInventoryCatalogRelation) —
          // misma política exacta por ley distributiva:
          // (A∧C)∨(B∧C) ≡ C∧(A∨B).
          && hasValidBusinessInventoryStructure(businessId)
          && (
            (
              request.resource.data.get("modeloInventarioVersion", null) == 2
              && request.resource.data.get("codigoInterno", null) is string
              && request.resource.data.get("codigoInterno", "").size() > 0
            )
            || (
              resource.data.get("modeloInventarioVersion", null) == null
              && request.resource.data.get("modeloInventarioVersion", null) == null
              && request.resource.data.get("codigoInterno", null) == null
              && request.resource.data.negocioId == businessId
            )
          );
        allow delete: if false;
      }

      match /areas/{areaId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "VENTAS", "COMPRAS", "TECNICO", "FINANZAS", "MEMBER"], ["inventario", "cotizaciones", "ordenes_compra", "recepciones", "compras", "trabajos", "reportes"]);
        allow create, update, delete: if false;
      }

      match /categoriasInventario/{categoryId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "VENTAS", "COMPRAS", "TECNICO", "FINANZAS", "MEMBER"], ["inventario", "cotizaciones", "ordenes_compra", "recepciones", "compras", "trabajos", "reportes"]);
        allow create, update, delete: if false;
      }

      match /inventarioContadores/{counterId} {
        allow read, create, update, delete: if false;
      }

      match /inventoryCatalogKeys/{keyId} {
        allow read, create, update, delete: if false;
      }

      match /inventoryCreateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /inventoryImportRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /inventoryUpdateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /inventoryCodeKeys/{codeKeyId} {
        allow read, create, update, delete: if false;
      }

      match /inventoryBarcodeKeys/{barcodeKeyId} {
        allow read, create, update, delete: if false;
      }

      match /inventoryStatusRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /referencias/{referenceId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "VENTAS", "COMPRAS", "MEMBER"], ["cotizaciones", "ordenes_compra", "reportes"]);
        allow create, update: if hasBusinessRole(businessId, ["OWNER", "ADMIN"])
          && hasValidBusinessDocument(businessId);
        allow delete: if false;
      }

      match /cotizaciones/{quoteId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "VENTAS", "FINANZAS", "MEMBER"], ["cotizaciones", "reportes"]);
        allow create: if false;
        allow update: if false;
        allow delete: if false;

        match /eventos/{eventId} {
          allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "VENTAS", "FINANZAS", "MEMBER"], ["cotizaciones", "reportes"]);
          allow create, update, delete: if false;
        }
      }

      match /clientes/{clienteId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "VENTAS", "MEMBER"], ["clientes", "cotizaciones", "reportes"])
          && resource.data.negocioId == businessId;
        allow create, update, delete: if false;
      }

      match /trabajos/{trabajoId} {
        allow read: if resource.data.negocioId == businessId
          && (
            hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "FINANZAS", "MEMBER"], ["trabajos", "reportes"])
            || (
              hasBusinessRole(businessId, ["TECNICO"])
              && isAssignedWorkData(resource.data)
            )
          );
        allow create, update, delete: if false;

        match /tareas/{tareaId} {
          allow read: if canReadWorkOperations(businessId, trabajoId)
            && resource.data.negocioId == businessId
            && resource.data.trabajoId == trabajoId
            && (
              !hasBusinessRole(businessId, ["TECNICO"])
              || resource.data.get("responsableUid", "") == request.auth.uid
            );
          allow create, update, delete: if false;

          match /documentacion/{documentacionId} {
            allow read: if canReadWorkOperations(businessId, trabajoId)
              && resource.data.negocioId == businessId
              && resource.data.trabajoId == trabajoId
              && resource.data.tareaId == tareaId
              && (
                !hasBusinessRole(businessId, ["TECNICO"])
                || get(/databases/$(database)/documents/negocios/$(businessId)/trabajos/$(trabajoId)/tareas/$(tareaId)).data.get("responsableUid", "") == request.auth.uid
              );
            allow create, update, delete: if false;
          }
        }

        match /notas/{notaId} {
          allow read: if canReadWorkOperations(businessId, trabajoId)
            && resource.data.negocioId == businessId
            && resource.data.trabajoId == trabajoId;
          allow create, update, delete: if false;
        }

        match /gastos/{gastoId} {
          allow read: if canReadWorkCosts(businessId, trabajoId, resource.data)
            && resource.data.negocioId == businessId
            && resource.data.trabajoId == trabajoId;
          allow create, update, delete: if false;
        }

        match /horasHombre/{horasHombreId} {
          allow read: if canReadWorkCosts(businessId, trabajoId, resource.data)
            && resource.data.negocioId == businessId
            && resource.data.trabajoId == trabajoId;
          allow create, update, delete: if false;
        }

        // SPEC 020 (Adicionales facturables): mismo patrón exacto que gastos/
        // horasHombre. La creación es exclusiva de crearAdicionalTrabajo (que
        // siempre fija estado en PENDIENTE_COBRO); la transición a
        // INCORPORADO_A_VENTA sólo existirá dentro de confirmarVenta (ETAPA 5,
        // no implementada todavía). Ningún cliente puede crear, actualizar ni
        // eliminar un adicional directamente, cualquiera sea el estado que
        // intente asignarle.
        match /adicionales/{adicionalId} {
          allow read: if canReadWorkCosts(businessId, trabajoId, resource.data)
            && resource.data.negocioId == businessId
            && resource.data.trabajoId == trabajoId;
          allow create, update, delete: if false;
        }

        match /historial/{eventoId} {
          allow read: if canReadWorkOperations(businessId, trabajoId)
            && resource.data.negocioId == businessId
            && resource.data.trabajoId == trabajoId;
          allow create, update, delete: if false;
        }

        match /vinculos/{vinculoId} {
          allow read: if canReadWorkOperations(businessId, trabajoId)
            && resource.data.negocioId == businessId
            && resource.data.trabajoId == trabajoId;
          allow create, update, delete: if false;
        }
      }

      match /workCounters/{counterId} {
        allow read, create, update, delete: if false;
      }

      match /workCreateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /workTaskRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /workCostRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /workMaterialRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /workMaterialBalances/{balanceId} {
        allow read, create, update, delete: if false;
      }

      match /clientRutKeys/{rutKey} {
        allow read, create, update, delete: if false;
      }

      match /proveedores/{proveedorId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "COMPRAS", "MEMBER"], ["proveedores", "ordenes_compra", "reportes"])
          && resource.data.negocioId == businessId;
        allow create, update, delete: if false;
      }

      match /providerRutKeys/{rutKey} {
        allow read, create, update, delete: if false;
      }

      match /providerCreateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /ordenesCompra/{ordenCompraId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "COMPRAS", "FINANZAS", "MEMBER"], ["ordenes_compra", "reportes"])
          && resource.data.negocioId == businessId;
        allow create, update, delete: if false;
      }

      match /purchaseOrderCounters/{counterId} {
        allow read, create, update, delete: if false;
      }

      match /purchaseOrderCreateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /purchaseOrderDuplicateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /purchaseOrderEmailAttempts/{attemptId} {
        allow read, create, update, delete: if false;
      }

      match /recepciones/{recepcionId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "COMPRAS", "FINANZAS", "MEMBER"], ["recepciones", "reportes"])
          && resource.data.negocioId == businessId;
        allow create, update, delete: if false;
      }

      match /solicitudesVerificacionEmpresa/{solicitudId} {
        allow read: if hasSetupBusinessRole(businessId, ["OWNER"])
          && resource.data.negocioId == businessId;
        allow create, update, delete: if false;
      }

      match /eventosVerificacionEmpresa/{eventoId} {
        allow read: if hasSetupBusinessRole(businessId, ["OWNER"])
          && resource.data.negocioId == businessId;
        allow create, update, delete: if false;
      }

      match /businessVerificationRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /platformVerificationDecisionRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /platformBusinessStatusRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /receptionCounters/{counterId} {
        allow read, create, update, delete: if false;
      }

      match /receptionCreateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /receptionConfirmRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /receptionPurchaseConversionRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /compras/{compraId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "COMPRAS", "FINANZAS", "MEMBER"], ["compras", "reportes"])
          && resource.data.negocioId == businessId;
        allow create, update, delete: if false;
      }

      match /movimientosInventario/{movimientoId} {
        allow read: if resource.data.negocioId == businessId
          && (
            hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "VENTAS", "COMPRAS", "FINANZAS", "MEMBER"], ["inventario", "trabajos", "ventas", "recepciones", "compras", "reportes"])
            || (
              resource.data.get("trabajoId", "") != ""
              && canReadWork(businessId, resource.data.trabajoId)
              && hasBusinessRole(businessId, ["TECNICO"])
            )
          );
        allow create, update, delete: if false;
      }

      match /adquisicionesInventario/{adquisicionId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "COMPRAS", "FINANZAS", "MEMBER"], ["inventario", "recepciones", "compras", "reportes"])
          && resource.data.negocioId == businessId;
        allow create, update, delete: if false;
      }

      match /purchaseCounters/{counterId} {
        allow read, create, update, delete: if false;
      }

      match /purchaseCreateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /purchaseConfirmRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /purchaseReversalRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /purchaseOrderConversionRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /ventas/{ventaId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "VENTAS", "FINANZAS", "MEMBER"], ["ventas", "reportes"])
          && resource.data.negocioId == businessId;
        allow create, update, delete: if false;
      }

      match /saleCounters/{counterId} {
        allow read, create, update, delete: if false;
      }

      match /saleCreateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /saleConfirmRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /saleCancellationRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /quoteSaleConversionRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /financialMovements/{movementId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "FINANZAS", "MEMBER"], ["reportes"]);
        allow create: if hasBusinessRole(businessId, ["OWNER", "ADMIN", "FINANZAS"])
          && isAllowedFinancialMovementCreate(businessId);
        allow update: if hasBusinessRole(businessId, ["OWNER", "ADMIN", "FINANZAS"])
          && isAllowedFinancialMovementUpdate(businessId);
        allow delete: if hasBusinessRole(businessId, ["OWNER", "ADMIN", "FINANZAS"])
          && resource.data.businessId == businessId
          && resource.data.sourceType == "manual";
      }

      match /contadores/{counterId} {
        allow read, create, update, delete: if false;
      }

      match /quoteCreateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /quoteDuplicateRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /quoteLifecycleRequests/{requestId} {
        allow read, create, update, delete: if false;
      }

      match /tareasReferencias/{taskId} {
        allow read: if hasBusinessModuleAccess(businessId, ["OWNER", "ADMIN", "VENTAS", "COMPRAS", "MEMBER"], ["cotizaciones", "ordenes_compra", "reportes"]);
        allow update: if hasBusinessRole(businessId, ["OWNER", "ADMIN"])
          && isAllowedReferenceTaskUpdate();
        allow create, delete: if false;
      }

      match /{document=**} {
        allow read, create, update, delete: if false;
      }
    }

    match /membresias/{membershipId} {
      allow read: if isSignedIn()
        && isPlatformUserActive(request.auth.uid)
        && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /quotePublicTokens/{tokenHash} {
      allow read, write: if false;
    }

    match /identidadesFiscalesVerificadas/{identidadId} {
      allow read, create, update, delete: if false;
    }

    match /platformUserStatusRequests/{requestId} {
      allow read, create, update, delete: if false;
    }

    match /paises/{countryCode} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /regiones/{regionCode} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /comunas/{communeCode} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /monedas/{currencyCode} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /rubros/{categoryCode} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /metadatos/{metadataId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }
  }
}
